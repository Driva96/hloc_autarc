{
  "name": "hloc-dev",
  "dockerComposeFile": ["./docker-compose.yml"],
  "service": "hloc",
  "workspaceFolder": "/hloc",
  "remoteUser": "root",
  "forwardPorts": [8888],
  "shutdownAction": "stopCompose",
  "runServices": ["hloc"],
  "hostRequirements": {
    "gpu": "optional" 
  },
  "postCreateCommand": "python -m pip install --no-deps -e . --no-build-isolation && nbstripout --install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "BUILDKIT_PROGRESS": "plain"
  }
}