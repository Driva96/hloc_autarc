
ARG UBUNTU_VERSION=24.04
ARG NVIDIA_CUDA_VERSION=12.9.1
# ==========================================
# STAGE 0: COLMAP
# ==========================================
FROM nvidia/cuda:${NVIDIA_CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS colmap-builder

ARG COLMAP_TAG=3.13.0
ARG CUDA_ARCHITECTURES=all-major
ENV QT_XCB_GL_INTEGRATION=xcb_egl
ENV DEBIAN_FRONTEND=noninteractive

# Prevent stop building ubuntu at time zone selection.
ENV DEBIAN_FRONTEND=noninteractive

# Prepare and empty machine for building.
RUN apt-get update && \
    apt-get install -y \
        git \
        cmake \
        ninja-build \
        build-essential \
        software-properties-common \
        libboost-program-options-dev \
        libboost-graph-dev \
        libboost-system-dev \
        libeigen3-dev \
        libfreeimage-dev \
        libopenimageio-dev \
        openimageio-tools \
        libmetis-dev \
        libgoogle-glog-dev \
        libgtest-dev \
        libgmock-dev \
        libsqlite3-dev \
        libglew-dev \
        qt6-base-dev \
        libqt6opengl6-dev \
        libqt6openglwidgets6 \
        libcgal-dev \
        libceres-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        # Intel MKL
        # libmkl-full-dev
        # OpenBLAS (much smaller)
        libopenblas-openmp-dev

# Fix issue in Ubuntu's openimageio CMake config.
# We don't depend on any of openimageio's OpenCV functionality,
# but it still requires the OpenCV include directory to exist.
RUN mkdir -p /usr/include/opencv4

# Build and install COLMAP.
RUN git clone https://github.com/colmap/colmap.git
RUN cd colmap && \
    git fetch https://github.com/colmap/colmap.git ${COLMAP_TAG} && \
    git checkout FETCH_HEAD && \
    mkdir build && \
    cmake -S . -B build -GNinja \
        -DGUI_ENABLED=OFF \
        -DCUDA_ENABLED=ON \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
        -DCMAKE_INSTALL_PREFIX=/colmap-install \
        -DBLA_VENDOR=OpenBLAS && \
        # -DBLA_VENDOR=Intel10_64lp && \
    ninja -C build install

# ==========================================
# STAGE 1: BUILDER
# Combines OpenMVS, and CMVS compilation
# ==========================================

FROM nvidia/cuda:${NVIDIA_CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS builder-deploy

ENV DEBIAN_FRONTEND=noninteractive
ARG CUDA_ARCHITECTURES=all-major
ARG COLMAP_TAG=3.13.0

# Update version to match System Python on Ubuntu 24.04
ARG PYTHON_VERSION=3.12

# Allow pip to modify system python (Required for Ubuntu 24.04+)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# OpenMVS Build Args
ENV EIGEN_BUILD_ARG="-DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda/"
ENV OPENMVS_BUILD_ARG="-DOpenMVS_USE_CUDA=ON -DOpenMVS_USE_OPENMP=ON  -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs/ -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda/ -DCUDA_INCLUDE_DIRS=/usr/local/cuda/include/ -DCUDA_CUDART_LIBRARY=/usr/local/cuda/lib64 -DCUDA_NVCC_EXECUTABLE=/usr/local/cuda/bin/ -DCMAKE_CUDA_ARCHITECTURES=all-major"

# 1. Install ALL build dependencies
# [CHANGE 3] Added python3-dev, pip, and python-is-python3 directly here.
# Removed external PPA setup.
RUN apt-get update && apt-get install -y \
        git cmake ninja-build build-essential software-properties-common wget unzip \
        libboost-all-dev libeigen3-dev libfreeimage-dev libmetis-dev \
        libgoogle-glog-dev libgtest-dev libgmock-dev libsqlite3-dev libglew-dev \
        qt6-base-dev libqt6opengl6-dev libqt6openglwidgets6 libcgal-dev \
        libceres-dev libcurl4-openssl-dev libssl-dev \
        # Intel MKL
        # libmkl-full-dev \
        # OpenBLAS (much smaller)
        libopenblas-openmp-dev \
        libopencv-dev libnanoflann-dev libgmp-dev libmpfr-dev zlib1g-dev \
        libopenimageio-dev openimageio-tools \
        libjxl-dev libtbb-dev \
        python3-dev libpython3-dev python3-pip python3-setuptools python3-wheel python-is-python3 \
        libpng-dev \ 
        libjpeg-dev \
        libtiff-dev \
        libglu1-mesa-dev \
        libglew-dev \
        libglfw3-dev && \
    rm -rf /var/lib/apt/lists/* && \
    update-ca-certificates

# [CHANGE 4] Removed the separate "Install Python via Deadsnakes" block entirely.
# The previous Step 2 is now redundant because 3.12 is installed in Step 1.

# Configure git for better SSL handling
RUN git config --global http.sslVerify true && \
    git config --global http.postBuffer 524288000

# Keep distro pip and layer a newer pip without uninstalling apt-managed package.
RUN python -m pip install --upgrade --ignore-installed pip

COPY --from=colmap-builder /colmap-install/ /usr/local/

# 4. Build PyCOLMAP Wheel
RUN python -m pip install build setuptools wheel tomlkit
RUN git clone https://github.com/colmap/colmap.git
RUN cd colmap && \
    git fetch https://github.com/colmap/colmap.git ${COLMAP_TAG} && \
    git checkout FETCH_HEAD && \
    python python/ci/update_pyproject_toml.py --name "pycolmap-cuda12" && \
    CMAKE_ARGS="-Dcolmap_DIR=/usr/local/share/colmap" pip wheel . -w /dist --no-deps

# 5. Build CGAL 6
RUN apt-get remove -y libcgal-dev && \
    apt-get autoremove -y 
RUN git clone https://github.com/cgal/cgal --branch=v6.0.1 && \
    cmake -S cgal -B cgal_build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/cgal6 && \
    cmake --build cgal_build --target install

# 6. Build OpenMVS
ENV CPLUS_INCLUDE_PATH="/usr/include/python3.12:$CPLUS_INCLUDE_PATH"

#VCG and Eigen are OpenMVS dependencies that we need to build first.
RUN git clone https://github.com/cdcseacave/VCG.git /vcglib
RUN git clone https://gitlab.com/libeigen/eigen /eigen34 --branch 3.4 

RUN git clone https://github.com/cdcseacave/openMVS.git /openMVS --branch=develop && \
    cd /openMVS && \
    git submodule update --init --recursive && \
    sed -i 's/IMWRITE_JPEGXL_QUALITY/IMWRITE_JPEG_QUALITY/g' /openMVS/libs/Common/Types.inl && \
    cmake -S . -B build \
        -DOpenMVS_USE_QT=OFF -DQt6_DIR=/usr/lib/x86_64-linux-gnu/cmake/Qt6 \
        -DCMAKE_BUILD_TYPE=Release \
        # BLAS Vendor
        -DBLA_VENDOR=OpenBLAS \
        #-DBLA_VENDOR=Intel10_64lp \
        -DEIGEN3_INCLUDE_DIR=/eigen34 \
        # -DEIGEN3_INCLUDE_DIR=/usr/local/include/eigen3 \
        -DOpenMVS_MAX_CUDA_COMPATIBILITY=ON \
        -DVCG_ROOT=/vcglib \
        ${OPENMVS_BUILD_ARG} \
        -DOpenMVS_ENABLE_TESTS=OFF \
        -DCGAL_DIR=/opt/cgal6/lib/cmake/CGAL \
        -DCMAKE_INSTALL_PREFIX=/openmvs && \
    cmake --build build -j$(nproc) --config Release && \
    cmake --install build

# 7. Build CMVS-PMVS
RUN git clone https://github.com/Driva96/CMVS-PMVS.git && \
    cmake -S CMVS-PMVS/program -B cmvs_build -DCMAKE_INSTALL_PREFIX=/usr/local && \
    make -C cmvs_build install

# 8. Build MVS-Texturing
# 8. Build MVS-Texturing
RUN git clone https://github.com/nmoehrle/mvs-texturing.git /mvs-texturing && \
    # -----------------------------------------------------------------------
    # 1. Manually clone 'mve' to the location ExternalProject expects
    # -----------------------------------------------------------------------
    git clone https://github.com/nmoehrle/mve.git /mvs-texturing/elibs/mve && \
    # 2. DELETE .git folder to prevent CMake from resetting/updating the folder
    rm -rf /mvs-texturing/elibs/mve/.git && \
    # -----------------------------------------------------------------------
    # 3. Apply the "strings.h" name conflict fix
    # -----------------------------------------------------------------------
    # Rename the conflicting header
    mv /mvs-texturing/elibs/mve/libs/util/strings.h /mvs-texturing/elibs/mve/libs/util/util_strings.h && \
    # Fix local includes inside 'mve' (replaces #include "strings.h" with "util_strings.h")
    sed -i 's|"strings.h"|"util_strings.h"|g' /mvs-texturing/elibs/mve/libs/util/*.cc /mvs-texturing/elibs/mve/libs/util/*.h && \
    # Fix global includes in the whole project (replaces #include "util/strings.h")
    grep -rl 'util/strings.h' /mvs-texturing | xargs sed -i 's|util/strings.h|util/util_strings.h|g' && \
    # -----------------------------------------------------------------------
    # 4. SURGICAL FIX: Disable ONLY the 'mve' git download in elibs/CMakeLists.txt
    # We match the line containing "mve.git" and comment it out.
    # -----------------------------------------------------------------------
    sed -i 's|GIT_REPOSITORY.*https://github.com/nmoehrle/mve.git|# &|' /mvs-texturing/elibs/CMakeLists.txt && \
    # -----------------------------------------------------------------------
    # 5. Build
    # -----------------------------------------------------------------------
    cd /mvs-texturing && \
    mkdir build && cd build && \
    cmake -S .. -B . -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make install && \
    cd .. && rm -rf build


# ===============================================================================================================
# STAGE 2: DEPLOYABLE RUNTIME
# ===============================================================================================================
FROM nvidia/cuda:${NVIDIA_CUDA_VERSION}-base-ubuntu${UBUNTU_VERSION} AS runtime

# Update version to match System Python
ARG PYTHON_VERSION=3.12

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"
ENV PIP_ROOT_USER_ACTION=ignore

# [CHANGE 2] Allow pip to modify system python (Required for Ubuntu 24.04+)
ENV PIP_BREAK_SYSTEM_PACKAGES=1


# 1. Install Runtime Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        # CUDA Math Libs
        libcublas-12-9 \
        libcurand-12-9 \
        libcufft-12-9 \
        libcusolver-12-9 \
        libcusparse-12-9 \
        # Python 
        python3-pip python-is-python3 \
        # MKL
        # libmkl-intel-lp64 \
        # libmkl-intel-thread \
        # libmkl-core  \
        # OpenBLAS (much smaller)
        libopenblas0-openmp \
        # System Libs 
        libomp5 \
        libboost-program-options1.83.0 \
        libboost-serialization1.83.0 \
        libboost-iostreams1.83.0 \
        libboost-filesystem1.83.0 \
        libboost-system1.83.0 \
        libboost-graph1.83.0 \
        libgoogle-glog0v6t64 \
        libfreeimage3 \
        libgomp1 \
        libsqlite3-0 \
        libcurl4 \
        # libc6 \
        # Uncomment if not running in headless mode 
        # libqt6core6 libqt6gui6 libqt6widgets6 libqt6opengl6 libqt6openglwidgets6 \
        # Basic OpenGL support
        libglew2.2 libgl1 libopengl0 \
        libopencv-core406t64 libopencv-imgproc406t64 libopencv-imgcodecs406t64 libopencv-calib3d406t64 \
        # GLIB for OpenCV and OpenMVS
        libglib2.0-0 \
        libtbb12 \
        libjxl0.7 \
        libmetis5 \
        libceres4t64 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    update-ca-certificates

# Keep distro pip and layer a newer pip without uninstalling apt-managed package.
RUN python -m pip install --upgrade --ignore-installed pip

# 3.1 Copy Binaries from Builder 
COPY --from=builder-deploy /usr/local/bin/colmap /usr/local/bin/
COPY --from=builder-deploy /openmvs/bin /usr/local/bin/
# Uncomment if needed
#COPY --from=builder-deploy /usr/local/bin/cmvs /usr/local/bin/
#COPY --from=builder-deploy /usr/local/bin/pmvs2 /usr/local/bin/
COPY --from=builder-deploy /usr/local/bin/genOption /usr/local/bin/
COPY --from=builder-deploy /usr/local/bin/texrecon /usr/local/bin/

# 3.2 Strip Binaries 
# For debugguging comment the following (Human readable debug messages)
RUN apt-get update && apt-get install -y binutils && \
    strip --strip-unneeded /usr/local/bin/colmap \
    /usr/local/bin/OpenMVS/* \
    #/usr/local/bin/cmvs \
    #/usr/local/bin/pmvs2 \
    /usr/local/bin/texrecon && \
    apt-get remove -y binutils && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*
    
# If running with INtel MKL support 
# RUN strip --strip-unneeded /usr/lib/x86_64-linux-gnu/libmkl_*.so

# 4. Copy Shared Resources 
COPY --from=builder-deploy /usr/local/share/colmap /usr/local/share/colmap

# 6. Install Python Requirements
COPY requirements.txt /app/requirements.txt
WORKDIR /app

# Install PyTorch
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget unzip && \
    python -m pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cu124 \
    torch torchvision && \
    python -m pip install --no-cache-dir -r requirements.txt && \
    python -m pip install nbstripout && \
    apt-get remove -y git wget unzip && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# PyTorch Cleanup 
RUN SITE_PACKAGES=$(python -c 'import site; print(site.getsitepackages()[0])') && \
    rm -rf ${SITE_PACKAGES}/nvidia/nccl_cu12 && \
    rm -rf ${SITE_PACKAGES}/torch/lib/libnccl* && \
    rm -rf ${SITE_PACKAGES}/torch/include && \
    rm -rf ${SITE_PACKAGES}/torch/test && \
    find ${SITE_PACKAGES}/torch/lib -name "*.so" -exec strip --strip-unneeded {} + || true && \
    rm -rf /root/.cache/pip

# 5. Install PyColmap from Wheel
COPY --from=builder-deploy /dist /dist
RUN python -m pip install --no-cache-dir /dist/*.whl && rm -rf /dist

# 7. Copy Application Code
COPY . /app

# Optional: Pre-compile python bytecode
RUN python -m compileall /app

CMD ["/bin/bash", "-c", "echo 'Container is running. Replace this with your actual command.' && sleep infinity"]