    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: improved_pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_improved_pipeline.py",
            "args": ["-m","--overrides", "dataset=curved_04,curved_05,cut_too_close_01,worse_result_01,worse_result_02,worse_result_03", "reset=aggressive"],
            "console": "integratedTerminal"
        }
    ]
}